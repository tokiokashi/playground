#!/usr/bin/env bash
# 公開リポジトリのコミットメッセージに、セッションURLの行(Claude-Session:)を残さない。
# 同じセッションで作業を続けていることが、履歴から外に読み取れてしまうため。
# clone ごとに `git config core.hooksPath .githooks` が要る。
msg_file="$1"
tmp=$(mktemp) || exit 0
# -a: UTF-8 ロケールで不正なバイト列を含む行があると GNU grep がバイナリ扱いにして、
# その行を出さずに終了コード 0 を返す。-a で常にテキストとして読み、他の行を黙って失わない
grep -av '^Claude-Session:' "$msg_file" > "$tmp"
cat "$tmp" > "$msg_file"
rm -f "$tmp"
exit 0
